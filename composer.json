{
    "name": "hexblot/composer-remediate-db",
    "description": "A release channel for the composer-remediate advisory database: built from the public feeds on a schedule and published as GitHub releases. Fork it to run your own.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/hexblot/composer-remediate-db",
    "authors": [
        {
            "name": "Nikolaos Andriopoulos",
            "email": "nick.andriopoulos@lambda-twelve.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "composer/composer": "^2.9",
        "hexblot/composer-remediate": "0.11.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Remediate\\Channel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Remediate\\Channel\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/build-advisory-db"
    ],
    "config": {
        "allow-plugins": {
            "hexblot/composer-remediate": true
        },
        "sort-packages": true
    },
    "scripts": {
        "build": "@php bin/build-advisory-db --output=out/advisories.sqlite",
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}